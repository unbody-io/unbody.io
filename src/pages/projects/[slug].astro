---
import { siteConfig } from "@/config/site";
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;

const entry = await getEntry("projects", slug!);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);
const { title, blurb, date, tags, github, website, cover, heroVideo } =
  entry.data;

const getAttribute = (markup: string, name: string) =>
  markup.match(new RegExp(`${name}=("|')([\\s\\S]*?)\\1`, "i"))?.[2];

const cleanCaption = (caption: string) =>
  caption
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const entryBody = entry.body ?? "";

const figureImages = Array.from(entryBody.matchAll(/<figure>([\s\S]*?)<\/figure>/g))
  .map((match) => {
    const figure = match[1] ?? "";
    const imageMarkup = figure.match(/<img\s+([^>]*?)\/?>/i)?.[0] ?? "";
    const caption = figure.match(/<figcaption>([\s\S]*?)<\/figcaption>/i)?.[1] ?? "";
    const src = getAttribute(imageMarkup, "src");

    if (!src) return null;

    return {
      type: "image" as const,
      src,
      alt: getAttribute(imageMarkup, "alt") ?? title,
      caption: cleanCaption(caption),
    };
  })
  .filter(Boolean);

const galleryImages = figureImages.filter(
  (item): item is NonNullable<typeof item> => Boolean(item),
);

const mediaItemsBase = [
  ...(heroVideo
    ? [{
        type: "video" as const,
        src: heroVideo,
        alt: `${title} demo`,
        caption: `${title} demo`,
      }]
    : []),
  ...galleryImages.filter((item) => item.src !== cover),
];

const mediaItems = mediaItemsBase.map((item, carouselIndex) => ({
  ...item,
  carouselIndex,
}));
const carouselItems = mediaItems;

const projectUrl = `${siteConfig.url}/projects/${slug}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  description: blurb,
  url: projectUrl,
  datePublished: date,
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
  },
  ...(tags.length > 0 && { keywords: tags }),
};
---

<Base
  title={`${title} | Unbody Projects`}
  description={blurb}
  seo={{
    ogType: "article",
    article: {
      publishedTime: date,
      tags,
    },
    ogContentImage: cover,
    jsonLd,
  }}
>
  <div class="project-showcase">
    <header class="project-showcase__header">
      <div class="project-showcase__title-block">
        <h1>{title}</h1>
      </div>

      <div class="project-showcase__intro">
        <div class="project-showcase__intro-copy">
          <p>{blurb}</p>
          {tags.length > 0 && (
            <div class="project-showcase__tags" aria-label="Project tags">
              {tags.map((tag) => (
                <span data-type="meta">{tag}</span>
              ))}
            </div>
          )}
          <a href="#project-description" class="project-showcase__read-more">
            Read more
          </a>
        </div>
      </div>
    </header>

    {mediaItems.length > 0 && (
      <section class="project-showcase__media" aria-label={`${title} media`}>
        {mediaItems.map((item, index) => (
          <figure class="project-showcase__media-item">
            <button
              class="project-showcase__media-button"
              type="button"
              data-project-lightbox-open={item.carouselIndex}
              aria-label={`Open media ${item.carouselIndex + 1} of ${carouselItems.length}: ${item.alt}`}
            >
              {item.type === "video" ? (
                <video
                  src={item.src}
                  autoplay
                  loop
                  muted
                  playsinline
                  aria-label={item.alt}
                />
              ) : (
                <img
                  src={item.src}
                  alt={item.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              )}
            </button>
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    {carouselItems.length > 0 && (
      <div
        class="project-lightbox"
        data-project-lightbox
        aria-hidden="true"
        aria-label={`${title} media carousel`}
        aria-modal="true"
        inert
        role="dialog"
      >
        <button
          class="project-lightbox__close"
          type="button"
          data-project-lightbox-close
          aria-label="Close media carousel"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12" />
            <path d="M18 6L6 18" />
          </svg>
        </button>

        <div class="project-lightbox__viewport">
          <div class="project-lightbox__metadata">
            <p data-project-lightbox-title>{title}</p>
            <figcaption data-project-lightbox-caption>
              {carouselItems[0].caption || carouselItems[0].alt}
            </figcaption>
          </div>

          <div class="project-lightbox__track" data-project-lightbox-track>
            {carouselItems.map((item) => (
              <figure
                class="project-lightbox__slide"
                data-project-lightbox-slide
                data-project-lightbox-caption={item.caption || item.alt}
                aria-hidden={item.carouselIndex === 0 ? "false" : "true"}
              >
                <div class="project-lightbox__media-frame">
                  {item.type === "video" ? (
                    <video
                      src={item.src}
                      controls
                      autoplay
                      loop
                      muted
                      playsinline
                      data-project-lightbox-media
                      aria-label={item.alt}
                    />
                  ) : (
                    <img
                      src={item.src}
                      alt={item.alt}
                      loading="lazy"
                      data-project-lightbox-media
                    />
                  )}
                </div>
              </figure>
            ))}
          </div>
        </div>

        {carouselItems.length > 1 && (
          <div class="project-lightbox__dots" aria-label="Media carousel slides">
            {carouselItems.map((item) => (
              <button
                class="project-lightbox__dot"
                type="button"
                data-project-lightbox-dot={item.carouselIndex}
                aria-label={`Show media ${item.carouselIndex + 1}`}
                aria-current={item.carouselIndex === 0 ? "true" : "false"}
              >
                <span></span>
              </button>
            ))}
          </div>
        )}
      </div>
    )}

    <section id="project-description" class="project-showcase__copy">
      {(github || website) && (
        <div class="project-showcase__details">
          {(github || website) && (
            <div data-type="meta" class="project-showcase__links">
              {github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              )}
              {github && website && <span aria-hidden="true">|</span>}
              {website && (
                <a
                  href={website}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Website
                </a>
              )}
            </div>
          )}
        </div>
      )}

      <article class="prose project-showcase__body">
        <Content />
      </article>
    </section>
  </div>
</Base>

<style>
  .project-showcase {
    --project-page-inset: 1rem;
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    padding-inline: var(--project-page-inset);
  }

  .project-showcase__header {
    display: flex;
    min-height: clamp(22rem, 48dvh, 34rem);
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2.5rem, 8vh, 6rem);
    margin-top: 0;
    margin-bottom: clamp(1rem, 3vh, 2rem);
  }

  .project-showcase__title-block {
    width: 100%;
  }

  .project-showcase__header h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--foreground);
    font-family: var(--type-heading-family);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .project-showcase__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
    align-items: end;
  }

  .project-showcase__intro-copy {
    grid-column: span 12;
    max-width: 24rem;
  }

  .project-showcase__intro p {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--type-body-family);
    font-size: var(--type-body-md-size);
    font-weight: var(--type-body-md-weight);
    letter-spacing: var(--type-body-md-tracking);
    line-height: 1.55;
  }

  .project-showcase__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .project-showcase__tags span {
    border-radius: 999px;
    background: var(--foreground);
    color: var(--background);
    font-family: var(--type-ui-family);
    font-size: var(--type-ui-md-size);
    line-height: var(--type-ui-md-line-height);
    padding: 0.2rem 0.55rem;
    text-transform: uppercase;
  }

  .project-showcase__read-more {
    display: inline-flex;
    width: fit-content;
    margin-top: 1.25rem;
    border-radius: 0.25rem;
    color: var(--muted-foreground);
    font-family: var(--type-ui-family);
    font-size: var(--type-ui-md-size);
    line-height: var(--type-ui-md-line-height);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-transform: uppercase;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .project-showcase__read-more:hover,
  .project-showcase__read-more:focus-visible {
    background: var(--foreground);
    color: var(--background);
    outline: none;
    text-decoration: none;
  }

  .project-showcase__media {
    display: flex;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-inline: calc(var(--project-page-inset) * -1);
    overflow-x: auto;
    padding-inline: var(--project-page-inset);
    padding-bottom: 1rem;
    scroll-padding-inline: var(--project-page-inset);
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .project-showcase__media::-webkit-scrollbar {
    display: none;
  }

  .project-showcase__media-item {
    position: relative;
    flex: 0 0 auto;
    height: clamp(18rem, 48vw, 38rem);
    margin: 0;
    overflow: hidden;
    border-radius: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--surface-elevated);
    box-shadow: 0 1px 0 color-mix(in oklch, var(--foreground) 6%, transparent);
    scroll-snap-align: start;
  }

  .project-showcase__media-button {
    display: block;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: inherit;
    cursor: zoom-in;
    padding: 0;
  }

  .project-showcase__media-button:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -0.45rem;
  }

  .project-showcase__media-item img,
  .project-showcase__media-item video {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 1000ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-showcase__media-item:hover img,
  .project-showcase__media-item:hover video {
    transform: scale(1.035);
  }

  .project-showcase__media-item figcaption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    max-height: min(42%, 10rem);
    overflow: auto;
    border-radius: 0.75rem;
    background: rgb(0 0 0 / 72%);
    color: white;
    font-family: var(--type-ui-family);
    font-size: var(--type-ui-md-size);
    line-height: 1.35;
    opacity: 0;
    padding: 0.7rem 0.8rem;
    text-shadow: none;
    transform: translateY(0.5rem);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .project-showcase__media-item:hover figcaption {
    opacity: 0.92;
    transform: translateY(0);
  }

  .project-lightbox {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: grid;
    min-height: 100dvh;
    width: 100vw;
    background: var(--background);
    color: var(--foreground);
    pointer-events: none;
    transform: translate3d(0, 100dvh, 0);
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    visibility: hidden;
    will-change: transform;
  }

  .project-lightbox[data-open="true"] {
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
    visibility: visible;
  }

  .project-lightbox__viewport {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    min-height: 100dvh;
    width: 100vw;
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .project-lightbox__track {
    position: relative;
    width: 100%;
    height: calc(100dvh - clamp(2rem, 4vw, 3rem));
  }

  .project-lightbox__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin: 0;
    --project-lightbox-radius: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--project-lightbox-radius);
    background: transparent;
    opacity: var(--stack-opacity, 0);
    pointer-events: none;
    filter: blur(var(--stack-blur, 0px));
    transform:
      translate3d(0, var(--stack-y, 2rem), 0)
      scale(var(--stack-scale, 0.92));
    transform-origin: center top;
    z-index: var(--stack-z, 0);
    will-change: filter, opacity, transform;
  }

  .project-lightbox__slide[data-active="true"] {
    pointer-events: auto;
  }

  .project-lightbox__metadata {
    display: flex;
    min-height: calc(100dvh - clamp(2rem, 4vw, 3rem));
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    padding-bottom: clamp(4.5rem, 12vh, 7rem);
  }

  .project-lightbox__metadata p {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--type-ui-family);
    font-size: var(--type-ui-md-size);
    line-height: var(--type-ui-md-line-height);
    text-transform: uppercase;
  }

  .project-lightbox__metadata figcaption {
    margin: 0;
    color: var(--foreground);
    font-family: var(--type-heading-family);
    font-size: clamp(1.25rem, 2.35vw, 2.35rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.02;
    padding-right: clamp(1rem, 3vw, 3rem);
    text-wrap: balance;
  }

  .project-lightbox__media-frame {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--project-lightbox-radius);
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--foreground) 6%, transparent),
      0 var(--stack-shadow-y, 0.75rem) var(--stack-shadow-blur, 2rem)
        color-mix(in oklch, var(--foreground) var(--stack-shadow-alpha, 10%), transparent);
  }

  .project-lightbox__media-frame img,
  .project-lightbox__media-frame video {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: top left;
  }

  .project-lightbox__slide[data-media-orientation="landscape"] .project-lightbox__media-frame {
    aspect-ratio: var(--media-aspect-ratio, 16 / 9);
    height: auto;
    max-height: 100%;
  }

  .project-lightbox__slide[data-media-orientation="portrait"] .project-lightbox__media-frame {
    aspect-ratio: var(--media-aspect-ratio, 3 / 4);
    width: auto;
    height: 90%;
    max-width: 100%;
  }

  .project-lightbox__close {
    position: fixed;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    padding: 0;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .project-lightbox__close:hover,
  .project-lightbox__close:focus-visible {
    color: var(--muted-foreground);
    outline: none;
    transform: scale(0.94);
  }

  .project-lightbox__close svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .project-lightbox__close {
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
  }

  .project-lightbox__dots {
    position: fixed;
    z-index: 2;
    bottom: max(1rem, env(safe-area-inset-bottom));
    left: clamp(1rem, 2vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .project-lightbox__dot {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 1.35rem;
    height: 1.35rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .project-lightbox__dot span {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--foreground) 28%, transparent);
    transform-origin: left center;
    transition:
      background 220ms ease,
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      width 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-lightbox__dot[aria-current="true"] span {
    width: 1.15rem;
    background: var(--foreground);
    transform: scaleX(1.1);
  }

  .project-lightbox__dot:focus-visible {
    outline: 1px solid var(--foreground);
    outline-offset: 0.15rem;
  }

  .project-showcase__copy {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(4rem, 10vh, 7rem);
    scroll-margin-top: clamp(5rem, 12vh, 8rem);
  }

  .project-showcase__details {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-showcase__links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted-foreground);
  }

  .project-showcase__links a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 160ms ease;
  }

  .project-showcase__links a:hover,
  .project-showcase__links a:focus-visible {
    color: var(--foreground);
  }

  .project-showcase__body {
    grid-column: span 12;
    max-width: 48rem;
  }

  .project-showcase__body :global(figure:has(img)) {
    display: none;
  }

  .project-showcase__body :global(.project-recognition) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0 3.25rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
  }

  .project-showcase__body :global(.project-recognition span),
  .project-showcase__body :global(.project-recognition a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    border: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in oklch, var(--foreground) 3.5%, transparent);
    color: var(--foreground);
    font-family: var(--type-body-family);
    font-size: var(--type-body-md-size);
    letter-spacing: var(--type-body-md-tracking);
    line-height: 1.25;
    padding: 0.48rem 1.05rem;
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .project-showcase__body :global(.project-recognition a:hover),
  .project-showcase__body :global(.project-recognition a:focus-visible) {
    border-color: color-mix(in oklch, var(--foreground) 26%, transparent);
    background: color-mix(in oklch, var(--foreground) 7%, transparent);
    transform: translateY(-1px);
  }

  .project-showcase__body :global(.project-deliverables) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1.25rem 0 2.75rem;
  }

  .project-showcase__body :global(.project-deliverables article) {
    min-height: 8.75rem;
    margin: 0;
    border-radius: 0.5rem;
    background: color-mix(in oklch, var(--foreground) 3.75%, transparent);
    padding: 1.15rem;
  }

  .project-showcase__body :global(.project-deliverables p) {
    margin: 0 0 0.45rem;
    color: var(--muted-foreground);
    font-family: var(--type-ui-family);
    font-size: var(--type-ui-md-size);
    font-weight: var(--type-ui-md-weight);
    letter-spacing: var(--type-ui-md-tracking);
    line-height: var(--type-ui-md-line-height);
  }

  .project-showcase__body :global(.project-deliverables h3) {
    margin: 0;
    color: var(--foreground);
    font-family: var(--type-ui-family);
    font-size: var(--type-headline-sm-size);
    font-weight: var(--type-ui-md-weight);
    letter-spacing: var(--type-headline-sm-tracking);
    line-height: 1.13;
  }

  @media (min-width: 768px) {
    .project-showcase {
      --project-page-inset: 2rem;
    }

    .project-showcase__intro-copy {
      grid-column: span 5;
    }

    .project-showcase__details {
      grid-column: span 3;
    }

    .project-showcase__body {
      grid-column: 5 / span 7;
    }
  }

  @media (min-width: 1100px) {
    .project-showcase__body :global(.project-deliverables) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .project-showcase__header {
      min-height: clamp(18rem, 42dvh, 26rem);
      gap: clamp(2rem, 7vh, 4rem);
    }

    .project-showcase__media-item {
      height: 22rem;
      max-width: calc(100vw - 2.5rem);
    }

    .project-lightbox__slide {
      padding: 0;
    }

    .project-lightbox__viewport {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: 1rem;
      padding: 1rem 1rem 4rem;
    }

    .project-lightbox__track {
      height: 100%;
      min-height: 18rem;
    }

    .project-lightbox__metadata {
      min-height: 0;
      justify-content: flex-end;
      gap: 0.85rem;
      padding-right: 3.5rem;
      padding-bottom: 0;
    }

    .project-lightbox__metadata figcaption {
      max-width: 13ch;
      font-size: clamp(1.25rem, 6.5vw, 2rem);
      line-height: 1.04;
    }

    .project-lightbox__media-frame {
      height: 100%;
      min-height: 18rem;
    }

    .project-lightbox__slide[data-media-orientation="landscape"] .project-lightbox__media-frame {
      height: auto;
      min-height: 0;
    }

    .project-lightbox__slide[data-media-orientation="portrait"] .project-lightbox__media-frame {
      width: auto;
      height: 90%;
    }

    .project-showcase__body :global(.project-recognition) {
      gap: 0.55rem;
      margin-bottom: 2.25rem;
      padding-bottom: 2rem;
    }

    .project-showcase__body :global(.project-recognition span),
    .project-showcase__body :global(.project-recognition a) {
      width: 100%;
      border-radius: 1rem;
    }

    .project-showcase__body :global(.project-deliverables) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 1rem;
    }

    .project-showcase__body :global(.project-deliverables article) {
      min-height: 7.1rem;
      padding: 0.85rem;
    }

    .project-showcase__body :global(.project-deliverables p) {
      margin-bottom: 0.35rem;
      font-size: var(--type-ui-sm-size);
      line-height: var(--type-ui-sm-line-height);
    }

    .project-showcase__body :global(.project-deliverables h3) {
      font-size: clamp(1.05rem, 4.9vw, 1.35rem);
      line-height: 1.12;
    }
  }
</style>

<script>
  const initProjectLightbox = () => {
    const lightbox = document.querySelector<HTMLElement>("[data-project-lightbox]");
    if (!lightbox) return;
    if (lightbox.dataset.initialized === "true") return;
    lightbox.dataset.initialized = "true";

    const controller = new AbortController();
    const { signal } = controller;

    const openers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-project-lightbox-open]"),
    );
    const closeButton = lightbox.querySelector<HTMLButtonElement>(
      "[data-project-lightbox-close]",
    );
    const captionElement = lightbox.querySelector<HTMLElement>(
      "[data-project-lightbox-caption]",
    );
    const dots = Array.from(
      lightbox.querySelectorAll<HTMLButtonElement>("[data-project-lightbox-dot]"),
    );
    const slides = Array.from(
      lightbox.querySelectorAll<HTMLElement>("[data-project-lightbox-slide]"),
    );
    const mediaElements = slides.map((slide) =>
      slide.querySelector<HTMLImageElement | HTMLVideoElement>(
        "[data-project-lightbox-media]",
      ),
    );
    const videos = Array.from(lightbox.querySelectorAll<HTMLVideoElement>("video"));
    const captions = slides.map((slide) => slide.dataset.projectLightboxCaption ?? "");
    const slideCount = slides.length;
    const itemScrollStep = 640;
    const scrambleAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&*+-/:;<=>?@[]_{}~";
    let activeIndex = 0;
    let virtualScrollY = 0;
    let captionAnimationFrame = 0;
    let captionFromIndex = 0;
    let captionToIndex = 0;
    let captionProgress = 0;
    let touchStartY = 0;
    let lastFocusedElement: HTMLElement | null = null;
    let restoreFocusAfterHistoryClose = false;
    const mediaQueryKey = "media";

    const positiveModulo = (value: number, divisor: number) =>
      ((value % divisor) + divisor) % divisor;

    const getScrambleGlyph = (index: number, tick: number) => {
      const glyphIndex = positiveModulo(index * 13 + tick * 7, scrambleAlphabet.length);
      return scrambleAlphabet[glyphIndex] ?? "";
    };

    const getMediaIndexFromLocation = () => {
      const value = new URL(window.location.href).searchParams.get(mediaQueryKey);
      if (!value) return null;

      const index = Number(value) - 1;
      return Number.isInteger(index) ? positiveModulo(index, slideCount) : null;
    };

    const pushMediaState = (index: number) => {
      const url = new URL(window.location.href);
      const nextMedia = String(index + 1);
      if (url.searchParams.get(mediaQueryKey) === nextMedia) return;

      url.searchParams.set(mediaQueryKey, nextMedia);
      window.history.pushState(
        {
          ...(window.history.state && typeof window.history.state === "object"
            ? window.history.state
            : {}),
          projectLightbox: true,
        },
        "",
        url,
      );
    };

    const replaceWithoutMediaState = () => {
      const url = new URL(window.location.href);
      if (!url.searchParams.has(mediaQueryKey)) return;

      url.searchParams.delete(mediaQueryKey);
      window.history.replaceState(
        {
          ...(window.history.state && typeof window.history.state === "object"
            ? window.history.state
            : {}),
          projectLightbox: false,
        },
        "",
        url,
      );
    };

    const syncMediaMetrics = (
      slide: HTMLElement,
      media: HTMLImageElement | HTMLVideoElement | null,
    ) => {
      if (!media) return;

      const width = media instanceof HTMLVideoElement
        ? media.videoWidth
        : media.naturalWidth;
      const height = media instanceof HTMLVideoElement
        ? media.videoHeight
        : media.naturalHeight;

      if (!width || !height) return;

      slide.dataset.mediaOrientation = width >= height ? "landscape" : "portrait";
      slide.style.setProperty("--media-aspect-ratio", `${width} / ${height}`);
    };

    mediaElements.forEach((media, index) => {
      const slide = slides[index];
      if (!slide || !media) return;

      syncMediaMetrics(slide, media);

      if (media instanceof HTMLVideoElement) {
        media.addEventListener("loadedmetadata", () => {
          syncMediaMetrics(slide, media);
        }, { signal });
      } else if (media.complete) {
        syncMediaMetrics(slide, media);
      } else {
        media.addEventListener("load", () => {
          syncMediaMetrics(slide, media);
        }, { signal });
      }
    });

    const renderCaption = (time = performance.now()) => {
      if (!captionElement) return;

      const from = captions[captionFromIndex] ?? "";
      const to = captions[captionToIndex] ?? "";
      const progress = Math.min(Math.max(captionProgress, 0), 1);

      if (progress <= 0.2) {
        captionElement.textContent = from;
        return;
      }

      if (progress >= 0.8) {
        captionElement.textContent = to;
        return;
      }

      const transitionProgress = (progress - 0.2) / 0.6;
      const maxLength = Math.max(from.length, to.length);
      const activeCharIndex = Math.floor(transitionProgress * maxLength);
      const tick = Math.floor(time / 48);
      let text = "";

      for (let index = 0; index < maxLength; index += 1) {
        const fromChar = from[index] ?? "";
        const toChar = to[index] ?? "";

        if (index < activeCharIndex) {
          text += toChar;
        } else if (index === activeCharIndex) {
          text += getScrambleGlyph(index, tick);
        } else {
          text += fromChar;
        }
      }

      captionElement.textContent = text.trimEnd();
    };

    const runCaptionAnimation = (time: number) => {
      if (lightbox.dataset.open !== "true") {
        captionAnimationFrame = 0;
        return;
      }

      renderCaption(time);
      captionAnimationFrame = window.requestAnimationFrame(runCaptionAnimation);
    };

    const startCaptionAnimation = () => {
      if (!captionAnimationFrame) {
        captionAnimationFrame = window.requestAnimationFrame(runCaptionAnimation);
      }
    };

    const applyStack = (scrollY: number) => {
      if (slideCount === 0) return;

      const rawProgress = scrollY / itemScrollStep;
      const baseProgress = Math.floor(rawProgress);
      const segmentProgress = rawProgress - baseProgress;
      const baseIndex = positiveModulo(baseProgress, slideCount);
      const nextIndex = positiveModulo(baseIndex + 1, slideCount);
      const stackDepth = Math.min(3, slideCount - 1);
      const stackScaleStep = 0.045;
      const stackYStep = 14;
      captionFromIndex = baseIndex;
      captionToIndex = nextIndex;
      captionProgress = segmentProgress;

      activeIndex = positiveModulo(
        Math.round(rawProgress),
        slideCount,
      );

      dots.forEach((dot, dotIndex) => {
        dot.setAttribute("aria-current", String(dotIndex === activeIndex));
      });

      slides.forEach((slide, slideIndex) => {
        const forwardOffset = positiveModulo(slideIndex - baseIndex, slideCount);
        const backwardOffset = positiveModulo(baseIndex - slideIndex, slideCount);
        const isActive = slideIndex === activeIndex;
        let scale = 0.94;
        let y = "72dvh";
        let opacity = 0;
        let z = 0;
        let shadowDepth = 3;
        let blur = 2;

        if (slideIndex === baseIndex) {
          scale = 1 - segmentProgress * stackScaleStep;
          y = `${(-stackYStep * segmentProgress).toFixed(2)}px`;
          opacity = 1 - segmentProgress * 0.14;
          z = 30;
          shadowDepth = segmentProgress;
          blur = segmentProgress * 1.2;
        } else if (slideIndex === nextIndex) {
          scale = 1;
          y = `${((1 - segmentProgress) * 72).toFixed(3)}dvh`;
          opacity = 1;
          z = 40;
          shadowDepth = 1 - segmentProgress;
          blur = 0;
        } else if (backwardOffset > 0 && backwardOffset <= stackDepth) {
          const layerDepth = backwardOffset + segmentProgress;
          scale = 1 - layerDepth * stackScaleStep;
          y = `${(-stackYStep * layerDepth).toFixed(2)}px`;
          opacity = Math.max(0.42, 0.86 - layerDepth * 0.12);
          z = 30 - backwardOffset;
          shadowDepth = layerDepth;
          blur = Math.min(3, layerDepth * 0.85);
        } else if (forwardOffset > 1 && forwardOffset <= stackDepth + 1) {
          y = `${(72 + (forwardOffset - 1) * 10).toFixed(2)}dvh`;
        }

        slide.style.setProperty("--stack-scale", scale.toFixed(4));
        slide.style.setProperty("--stack-y", y);
        slide.style.setProperty("--stack-opacity", opacity.toFixed(4));
        slide.style.setProperty("--stack-blur", `${blur.toFixed(2)}px`);
        slide.style.setProperty("--stack-z", String(z));
        slide.style.setProperty(
          "--stack-shadow-y",
          `${(0.75 + shadowDepth * 0.35).toFixed(2)}rem`,
        );
        slide.style.setProperty(
          "--stack-shadow-blur",
          `${(2 + shadowDepth * 0.6).toFixed(2)}rem`,
        );
        slide.style.setProperty(
          "--stack-shadow-alpha",
          `${Math.max(6, 14 - shadowDepth * 2).toFixed(2)}%`,
        );
        slide.setAttribute("aria-hidden", String(!isActive));
        slide.dataset.active = String(isActive);
      });

      renderCaption();

      videos.forEach((video) => {
        const slide = video.closest<HTMLElement>("[data-project-lightbox-slide]");
        if (slide === slides[activeIndex] && lightbox.dataset.open === "true") {
          void video.play();
        } else {
          video.pause();
        }
      });
    };

    const setScrollY = (nextScrollY: number) => {
      virtualScrollY = nextScrollY;
      applyStack(virtualScrollY);
    };

    const setActiveSlide = (index: number) => {
      if (slideCount === 0) return;

      const requestedIndex = positiveModulo(index, slideCount);
      const currentIndex = positiveModulo(
        Math.round(virtualScrollY / itemScrollStep),
        slideCount,
      );
      let step = requestedIndex - currentIndex;

      if (step > slideCount / 2) step -= slideCount;
      if (step < -slideCount / 2) step += slideCount;

      setScrollY(virtualScrollY + step * itemScrollStep);
    };

    const scrollStack = (delta: number) => {
      setScrollY(virtualScrollY + delta);
    };

    const close = ({
      fromHistory = false,
      restoreFocus = true,
    }: {
      fromHistory?: boolean;
      restoreFocus?: boolean;
    } = {}) => {
      const hasMediaQuery = new URL(window.location.href).searchParams.has(mediaQueryKey);
      if (
        !fromHistory &&
        hasMediaQuery &&
        window.history.state?.projectLightbox === true
      ) {
        restoreFocusAfterHistoryClose = restoreFocus;
        window.history.back();
        return;
      }

      if (!fromHistory) replaceWithoutMediaState();

      lightbox.dataset.open = "false";
      lightbox.setAttribute("aria-hidden", "true");
      lightbox.setAttribute("inert", "");
      document.documentElement.style.overflow = "";
      videos.forEach((video) => video.pause());
      if (captionAnimationFrame) {
        window.cancelAnimationFrame(captionAnimationFrame);
        captionAnimationFrame = 0;
      }
      if (restoreFocus) lastFocusedElement?.focus();
    };

    const open = (
      index: number,
      trigger?: HTMLElement,
      { syncHistory = true }: { syncHistory?: boolean } = {},
    ) => {
      if (trigger) lastFocusedElement = trigger;
      virtualScrollY = positiveModulo(index, slideCount) * itemScrollStep;
      applyStack(virtualScrollY);
      lightbox.dataset.open = "true";
      lightbox.setAttribute("aria-hidden", "false");
      lightbox.removeAttribute("inert");
      document.documentElement.style.overflow = "hidden";
      closeButton?.focus();
      applyStack(virtualScrollY);
      if (syncHistory) pushMediaState(positiveModulo(index, slideCount));
      startCaptionAnimation();
    };

    openers.forEach((button) => {
      button.addEventListener("click", () => {
        open(Number(button.dataset.projectLightboxOpen ?? 0), button);
      }, { signal });
    });

    closeButton?.addEventListener("click", () => close(), { signal });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        setActiveSlide(Number(dot.dataset.projectLightboxDot ?? 0));
      }, { signal });
    });

    lightbox.addEventListener("wheel", (event) => {
      if (lightbox.dataset.open !== "true") return;
      event.preventDefault();
      scrollStack(event.deltaY);
    }, { signal, passive: false });

    lightbox.addEventListener("touchstart", (event) => {
      touchStartY = event.touches[0]?.clientY ?? 0;
    }, { signal, passive: true });

    lightbox.addEventListener("touchmove", (event) => {
      if (lightbox.dataset.open !== "true") return;
      event.preventDefault();
      const nextY = event.touches[0]?.clientY ?? touchStartY;
      const delta = touchStartY - nextY;
      touchStartY = nextY;
      scrollStack(delta * 1.4);
    }, { signal, passive: false });

    document.addEventListener("keydown", (event) => {
      if (lightbox.dataset.open !== "true") return;

      if (event.key === "Escape") {
        close();
      } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
        setActiveSlide(activeIndex - 1);
      } else if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        setActiveSlide(activeIndex + 1);
      }
    }, { signal });

    setScrollY(0);

    const syncLightboxFromLocation = () => {
      const mediaIndex = getMediaIndexFromLocation();

      if (mediaIndex === null) {
        if (lightbox.dataset.open === "true") {
          const shouldRestoreFocus = restoreFocusAfterHistoryClose;
          restoreFocusAfterHistoryClose = false;
          close({ fromHistory: true, restoreFocus: shouldRestoreFocus });
        }
        return;
      }

      open(mediaIndex, undefined, { syncHistory: false });
    };

    window.addEventListener("popstate", syncLightboxFromLocation, { signal });
    syncLightboxFromLocation();

    document.addEventListener("astro:before-swap", () => {
      document.documentElement.style.overflow = "";
      if (captionAnimationFrame) {
        window.cancelAnimationFrame(captionAnimationFrame);
      }
      controller.abort();
    }, { once: true });
  };

  document.addEventListener("astro:page-load", initProjectLightbox);
  initProjectLightbox();
</script>
