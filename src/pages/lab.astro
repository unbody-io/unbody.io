---
import Base from "../layouts/Base.astro";
import Manifesto from "../components/Manifesto.astro";
---

<Base title="Lab | Unbody Lab">
  <main class="min-h-screen relative flex flex-col items-center">
    <div class="relative z-10 w-full max-w-xl pt-40 pb-48">
      <Manifesto />

      <div class="mt-32 pb-12 flex flex-col items-center opacity-30">
        <div class="w-px h-24 bg-gradient-to-b from-foreground to-transparent mb-8"></div>
        <p class="uppercase tracking-ultra whitespace-nowrap">
          Unbody Research Division
        </p>
        <p class="mt-4 tracking-label">
          LATENT_SPACE_EXPLORATION_V.08
        </p>
      </div>
    </div>
  </main>
</Base>
