---
import Base from "../layouts/Base.astro";
---

<Base title="Unbody — The Supabase of A.I. Era">
  <main class="min-h-screen relative flex flex-col items-center">
    <div class="prose relative z-10 w-full max-w-xl pt-40 pb-48">
      <header>
        <p>
          <em>The Supabase of A.I. Era</em>
        </p>
        <p>
          Build AI-native backends with built-in agents, vector storage,
          and APIs — all from one modular, open-source stack.
        </p>
      </header>

      <p>
        Unbody beta is waiting list only.
        <a href="https://forms.gle/REPLACE_ME" class="underline">Request access</a>.
      </p>
    </div>
  </main>
</Base>
