---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getAuthor } from "@/config/authors";
import type { PostMetadata } from "@/types/data.types";
import postsMetadata from "../../../data/posts-metadata.gen.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;

const metadata = (postsMetadata as PostMetadata[]).find((p) => p.slug === slug);
if (!metadata) {
  return Astro.redirect("/404");
}

const entry = await getEntry("blog", slug!);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

const author = getAuthor(metadata.author);
const formattedDate = new Date(metadata.publishDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={`${metadata.title} | Unbody Blog`} description={metadata.blurb}>
  <main class="min-h-screen relative flex flex-col items-center selection:bg-foreground selection:text-background">
    <div class="relative z-10 w-full max-w-3xl pt-40 pb-48">
      <header class="mb-16">
        <div class="mb-6 flex items-center gap-3 text-sm text-muted-foreground">
          <time datetime={metadata.publishDate}>{formattedDate}</time>
          <span class="opacity-30">|</span>
          <span>{metadata.readingTime} min read</span>
        </div>

        <h1 class="mb-6 text-2xl text-foreground leading-tight">
          {metadata.title}
        </h1>

        {author && (
          <div class="flex items-center gap-3 text-sm text-muted-foreground">
            <span>By {author.name}</span>
            <span class="opacity-30">|</span>
            <span>{author.title}</span>
          </div>
        )}
      </header>

      <article class="blog-content">
        <Content />
      </article>

      <footer class="mt-20 pt-10 border-t border-border">
        <div class="flex flex-wrap gap-2">
          {metadata.keywords.slice(0, 5).map((keyword) => (
            <span class="px-2 py-1 text-xs text-muted-foreground uppercase tracking-wider border border-border rounded">
              {keyword}
            </span>
          ))}
        </div>
      </footer>
    </div>
  </main>
</Base>
