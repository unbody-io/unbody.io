---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getAuthor } from "@/config/authors";
import type { PostMetadata } from "@/types/data.types";
import postsMetadata from "../../../data/posts-metadata.gen.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;

const metadata = (postsMetadata as PostMetadata[]).find((p) => p.slug === slug);
if (!metadata) {
  return Astro.redirect("/404");
}

const entry = await getEntry("blog", slug!);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

const author = getAuthor(metadata.author);
const formattedDate = new Date(metadata.publishDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={`${metadata.title} | Unbody Blog`} description={metadata.blurb}>
  <header class="mb-16 text-muted-foreground">
    <div class="mb-6 flex items-center gap-3 text-sm">
      <time datetime={metadata.publishDate}>{formattedDate}</time>
      <span class="opacity-30">|</span>
      <span>{metadata.readingTime} min read</span>
    </div>

    <h1 class="mb-6">
      {metadata.title}
    </h1>

    {author && (
      <div class="flex items-center gap-3 text-sm">
        <span>By {author.name}</span>
        <span class="opacity-30">|</span>
        <span>{author.title}</span>
      </div>
    )}
  </header>

  <article class="prose">
    <Content />
  </article>

  <footer class="mt-20 pt-10 border-t border-border text-muted-foreground">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <a href={`/blog?category=${metadata.category}`} class="text-sm uppercase tracking-wider hover:text-foreground transition-colors duration-200">
        {metadata.category}
      </a>
      {metadata.relatedTopics.map((topic) => (
        <Fragment>
          <span class="opacity-30">·</span>
          <a href={`/blog?topic=${encodeURIComponent(topic.toUpperCase())}`} class="text-sm uppercase tracking-wider hover:text-foreground transition-colors duration-200">
            {topic}
          </a>
        </Fragment>
      ))}
    </div>
  </footer>
</Base>
