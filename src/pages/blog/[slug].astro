---
import { getAuthor } from "@/config/authors";
import { siteConfig } from "@/config/site";
import type { PostMetadata } from "@/types/data.types";
import { getCollection, getEntry, render } from "astro:content";
import postsMetadata from "../../../data/posts-metadata.gen.json";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const metadataSlugs = new Set(
    (postsMetadata as PostMetadata[]).map((p) => p.slug),
  );
  return posts
    .filter((post) => metadataSlugs.has(post.id))
    .map((post) => ({
      params: { slug: post.id },
    }));
}

const { slug } = Astro.params;

const metadata = (postsMetadata as PostMetadata[]).find((p) => p.slug === slug);
if (!metadata) {
  return Astro.redirect("/404");
}

const entry = await getEntry("blog", slug!);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

const author = getAuthor(metadata.author);
const formattedDate = new Date(metadata.publishDate).toLocaleDateString(
  "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);

const postUrl = `${siteConfig.url}/blog/${slug}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: metadata.title,
  description: metadata.blurb,
  url: postUrl,
  datePublished: metadata.publishDate,
  author: {
    "@type": "Person",
    name: author?.name ?? metadata.author,
    ...(author?.twitter && { url: `https://twitter.com/${author.twitter}` }),
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
  },
  keywords: metadata.keywords,
  ...(metadata.thumbnail && { image: metadata.thumbnail }),
};
---

<Base
  showBackButton={true}
  title={`${metadata.title} | Unbody Blog`}
  description={metadata.blurb}
  seo={{
    ogType: "article",
    article: {
      publishedTime: metadata.publishDate,
      author: author?.name,
      tags: metadata.keywords,
    },
    ogImage: metadata.thumbnail ?? undefined,
    jsonLd,
  }}
>
  <header class="mb-16 text-muted-foreground">
    <div data-type="meta" class="type-meta-md mb-6 flex items-center gap-3">
      <time datetime={metadata.publishDate}>{formattedDate}</time>
      <span class="opacity-30">|</span>
      <span>{metadata.readingTime} min read</span>
    </div>

    <h1 class="type-headline-xl mb-6 text-foreground">
      {metadata.title}
    </h1>

    {author && (
      <div data-type="meta" class="type-meta-md flex items-center gap-3">
        <span>By {author.name}</span>
        <span class="opacity-30">|</span>
        <span>{author.title}</span>
      </div>
    )}
  </header>

  <article class="prose">
    <Content />
  </article>

  <footer
    data-type="meta"
    class="type-meta-md mt-20 pt-10 border-t border-border"
  >
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <a
        href={`/blog?category=${metadata.category}`}
        class="type-ui-md uppercase tracking-wider hover:text-foreground transition-colors duration-200"
      >
        {metadata.category}
      </a>
      {metadata.relatedTopics.map((topic) => (
        <Fragment>
          <span class="opacity-30">·</span>
          <a
            href={`/blog?topic=${encodeURIComponent(topic.toUpperCase())}`}
            class="type-ui-md uppercase tracking-wider hover:text-foreground transition-colors duration-200"
          >
            {topic}
          </a>
        </Fragment>
      ))}
    </div>
  </footer>
</Base>
