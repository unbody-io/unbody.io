---
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import type { PostMetadata } from "@/types/data.types";
import postsMetadata from "../../../data/posts-metadata.gen.json";

const posts = [...(postsMetadata as PostMetadata[])].sort(
  (a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime()
);
---

<Base title="Blog | Unbody Lab">
  <main class="min-h-screen relative flex flex-col items-center">
    <div class="relative z-10 w-full max-w-3xl pt-40 pb-48">
      <header class="prose mb-16">
        <h1 class="mb-4 uppercase tracking-wider">Blog</h1>
        <p>
          Essays, updates, and explorations from the Unbody team.
        </p>
      </header>

      <div class="space-y-12">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </main>
</Base>
