---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Unbody Lab",
  description = "Where we question, explore, experiment and build adaptive thinking tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const stateKey = "__unbodySystemThemeSync";
        const existing = window[stateKey];
        if (existing && typeof existing.applySystemTheme === "function") {
          existing.applySystemTheme();
          return;
        }

        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const applySystemTheme = () => {
          const isDark = mediaQuery.matches;
          const resolvedTheme = isDark ? "dark" : "light";

          document.documentElement.classList.toggle("dark", isDark);
          document.documentElement.dataset.theme = resolvedTheme;
        };

        window[stateKey] = { applySystemTheme };
        applySystemTheme();

        if (typeof mediaQuery.addEventListener === "function") {
          mediaQuery.addEventListener("change", applySystemTheme);
        } else if (typeof mediaQuery.addListener === "function") {
          mediaQuery.addListener(applySystemTheme);
        }

        document.addEventListener("astro:after-swap", applySystemTheme);
        document.addEventListener("astro:page-load", applySystemTheme);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="font-mono text-foreground antialiased overflow-x-hidden">
    <!-- Fixed Ambient Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 ambient-bg-image"></div>
    </div>

    <!-- Top & Bottom Fade Masks -->
    <div class="fixed top-0 left-0 w-full h-24 md:h-48 z-40 bg-gradient-to-b from-background/60 via-background/30 to-transparent pointer-events-none"></div>
    <div class="fixed bottom-0 left-0 w-full h-48 md:h-64 z-40 bg-gradient-to-t from-background/90 via-background/50 to-transparent pointer-events-none"></div>

    <Header />

    <main class="min-h-screen relative flex flex-col items-center">
      <div class="relative z-10 w-full max-w-3xl px-5 pt-28 pb-32 md:pt-40 md:pb-48">
        <slot />
      </div>
    </main>

    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 md:left-auto md:translate-x-0 md:right-6 z-50 flex items-center gap-3 text-sm text-muted-foreground opacity-50">
      <a href="https://github.com/unbody-io" class="underline">GitHub</a>
      <span class="opacity-30">·</span>
      <a href="mailto:hello@unbody.io" class="underline">hello@unbody.io</a>
    </div>
  </body>
</html>
