---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
// Fonts (fontsource)
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/iosevka-curly/400.css";
import "@fontsource/iosevka-curly/500.css";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "@fontsource/lilex/400.css";
import "@fontsource/lilex/500.css";
import "@fontsource/commit-mono/400.css";
import "@fontsource/commit-mono/500.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/fragment-mono/400.css";
import "@fontsource/martian-mono/400.css";
import "@fontsource/martian-mono/500.css";
import "@fontsource/azeret-mono/400.css";
import "@fontsource/azeret-mono/500.css";
// Downloaded fonts registered via @font-face in globals.css
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Unbody Lab",
  description = "Where we question, explore, experiment and build adaptive thinking tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="font-mono text-black antialiased overflow-x-hidden">
    <!-- Fixed Ambient Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1513002749550-c59d786b8e6c?q=80&w=2000&auto=format&fit=crop'); filter: blur(120px) saturate(0.05) brightness(1.1); transform: scale(1.2);"
      ></div>
      <div class="absolute inset-0 bg-white/40"></div>
    </div>

    <!-- Top & Bottom Fade Masks -->
    <div class="fixed top-0 left-0 w-full h-48 z-40 bg-gradient-to-b from-white/60 via-white/30 to-transparent pointer-events-none"></div>
    <div class="fixed bottom-0 left-0 w-full h-48 z-40 bg-gradient-to-t from-white/60 via-white/30 to-transparent pointer-events-none"></div>

    <Header />

    <slot />

    <!-- DEBUG: Font switcher — remove before shipping -->
    <div transition:persist id="font-switcher" class="fixed bottom-6 right-6 z-[200] bg-black/80 backdrop-blur-sm text-white rounded-lg p-3 text-xs pointer-events-auto space-y-2">
      <label class="block mb-1.5 uppercase tracking-wider opacity-50">Font</label>
      <select id="font-select" class="bg-white/10 border border-white/20 rounded px-2 py-1.5 text-white text-xs w-full cursor-pointer">
        <option value="'IBM Plex Mono', monospace">IBM Plex Mono</option>
        <option value="'Iosevka Curly', monospace">Iosevka Curly</option>
        <option value="'DM Mono', monospace">DM Mono</option>
        <option value="'Lilex', monospace">Lilex</option>
        <option value="'Commit Mono', monospace">Commit Mono</option>
        <option value="'Geist Mono', monospace">Geist Mono</option>
        <option value="'Fragment Mono', monospace">Fragment Mono</option>
        <option value="'Martian Mono', monospace">Martian Mono</option>
        <option value="'Azeret Mono', monospace">Azeret Mono</option>
        <option value="'Basically A Mono', monospace">Basically A Mono</option>
        <option value="'Necto Mono', monospace">Necto Mono</option>
        <option value="'Sligoil', monospace">Sligoil</option>
        <option value="'Heming', monospace">Heming</option>
        <option value="'Lab Mono', monospace">Lab Mono</option>
        <option value="'Whois Mono', monospace">Whois Mono</option>
      </select>
      <label class="block mt-2 mb-1 uppercase tracking-wider opacity-50">Size <span id="size-label">12.5</span>px</label>
      <input id="font-size" type="range" min="10" max="18" step="0.5" value="12.5" class="w-full cursor-pointer accent-cyan-500" />
    </div>
    <script>
      function initDebugUI() {
        const select = document.getElementById("font-select") as HTMLSelectElement;
        const slider = document.getElementById("font-size") as HTMLInputElement;
        const sizeLabel = document.getElementById("size-label");
        if (!select || !slider || !sizeLabel) return;

        const savedFont = localStorage.getItem("debug-font");
        if (savedFont) {
          document.documentElement.style.setProperty("--font-ibm-plex-mono", savedFont);
          select.value = savedFont;
        }

        const savedSize = localStorage.getItem("debug-font-size");
        if (savedSize) {
          document.documentElement.style.fontSize = savedSize + "px";
          slider.value = savedSize;
          sizeLabel.textContent = savedSize;
        }

        select.addEventListener("change", () => {
          document.documentElement.style.setProperty("--font-ibm-plex-mono", select.value);
          localStorage.setItem("debug-font", select.value);
        });

        slider.addEventListener("input", () => {
          document.documentElement.style.fontSize = slider.value + "px";
          sizeLabel.textContent = slider.value;
          localStorage.setItem("debug-font-size", slider.value);
        });
      }

      initDebugUI();
      document.addEventListener("astro:after-swap", initDebugUI);
    </script>
  </body>
</html>
