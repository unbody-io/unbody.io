---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Unbody Lab",
  description = "Where we question, explore, experiment and build adaptive thinking tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="font-mono text-foreground antialiased overflow-x-hidden">
    <!-- Fixed Ambient Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 ambient-bg-image"></div>
      <div class="absolute inset-0 bg-background/40"></div>
    </div>

    <!-- Top & Bottom Fade Masks -->
    <div class="fixed top-0 left-0 w-full h-48 z-40 bg-gradient-to-b from-background/60 via-background/30 to-transparent pointer-events-none"></div>
    <div class="fixed bottom-0 left-0 w-full h-48 z-40 bg-gradient-to-t from-background/60 via-background/30 to-transparent pointer-events-none"></div>

    <Header />

    <slot />

    <div class="fixed bottom-6 right-6 z-50 flex items-center gap-3 text-sm text-muted-foreground opacity-50">
      <a href="https://github.com/unbody-io" class="underline">GitHub</a>
      <span class="opacity-30">·</span>
      <a href="mailto:hello@unbody.io" class="underline">hello@unbody.io</a>
    </div>
  </body>
</html>
