---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
// Fonts (fontsource)
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/iosevka-curly/400.css";
import "@fontsource/iosevka-curly/500.css";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "@fontsource/lilex/400.css";
import "@fontsource/lilex/500.css";
import "@fontsource/commit-mono/400.css";
import "@fontsource/commit-mono/500.css";
import "@fontsource-variable/geist-mono";
import "@fontsource/fragment-mono/400.css";
import "@fontsource-variable/martian-mono/standard.css";
import "@fontsource-variable/azeret-mono/wght.css";
import "@fontsource-variable/azeret-mono/wght-italic.css";
import "@fontsource-variable/recursive/full.css";
import "@fontsource/maple-mono/400.css";
import "@fontsource/maple-mono/500.css";
import "@fontsource/iosevka-aile/400.css";
import "@fontsource/iosevka-aile/500.css";
import "@fontsource-variable/archivo/standard.css";
import "@fontsource-variable/archivo/standard-italic.css";
import "@fontsource-variable/fredoka/standard.css";
import "@fontsource-variable/unbounded";
import "@fontsource-variable/funnel-display";
import "@fontsource-variable/epilogue/wght.css";
import "@fontsource-variable/epilogue/wght-italic.css";
import "@fontsource-variable/atkinson-hyperlegible-next/wght.css";
import "@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css";
import "@fontsource-variable/bricolage-grotesque";
// Downloaded fonts registered via @font-face in globals.css
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Unbody Lab",
  description = "Where we question, explore, experiment and build adaptive thinking tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="font-mono text-foreground antialiased overflow-x-hidden">
    <!-- Fixed Ambient Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 ambient-bg-image"></div>
      <div class="absolute inset-0 bg-background/40"></div>
    </div>

    <!-- Top & Bottom Fade Masks -->
    <div class="fixed top-0 left-0 w-full h-48 z-40 bg-gradient-to-b from-background/60 via-background/30 to-transparent pointer-events-none"></div>
    <div class="fixed bottom-0 left-0 w-full h-48 z-40 bg-gradient-to-t from-background/60 via-background/30 to-transparent pointer-events-none"></div>

    <Header />

    <slot />

    <!-- DEBUG: Font switcher — remove before shipping -->
    <div transition:persist id="font-switcher" class="fixed bottom-6 right-6 z-[200] bg-black/80 backdrop-blur-sm text-white rounded-lg p-3 text-xs pointer-events-auto space-y-2 max-h-[80vh] overflow-y-auto hide-scrollbar">
      <label class="block mb-1.5 uppercase tracking-wider opacity-50">Font <span id="font-index" class="opacity-70"></span></label>
      <div class="flex items-center gap-1">
        <button id="font-prev" class="px-2 py-1.5 bg-white/10 border border-white/20 rounded hover:bg-white/20 transition-colors cursor-pointer select-none">&larr;</button>
        <span id="font-name" class="flex-1 text-center px-2 py-1.5 bg-white/10 border border-white/20 rounded truncate"></span>
        <button id="font-next" class="px-2 py-1.5 bg-white/10 border border-white/20 rounded hover:bg-white/20 transition-colors cursor-pointer select-none">&rarr;</button>
      </div>
      <label class="block mt-2 mb-1 uppercase tracking-wider opacity-50">Size <span id="size-label">12.5</span>px</label>
      <input id="font-size" type="range" min="10" max="24" step="0.5" value="12.5" class="w-full cursor-pointer accent-cyan-500" />
      <div id="axis-controls"></div>
    </div>
    <script>
      type Axis = { tag: string; label: string; min: number; max: number; default: number; step: number };
      type Font = { value: string; label: string; axes?: Axis[] };

      const fonts: Font[] = [
        { value: "'IBM Plex Mono', monospace", label: "IBM Plex Mono" },
        { value: "'Iosevka Curly', monospace", label: "Iosevka Curly" },
        { value: "'DM Mono', monospace", label: "DM Mono" },
        { value: "'Lilex', monospace", label: "Lilex" },
        { value: "'Commit Mono', monospace", label: "Commit Mono" },
        {
          value: "'Geist Mono Variable', monospace", label: "Geist Mono",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 900, default: 400, step: 1 },
          ],
        },
        { value: "'Fragment Mono', monospace", label: "Fragment Mono" },
        {
          value: "'Martian Mono Variable', monospace", label: "Martian Mono",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 800, default: 400, step: 1 },
            { tag: "wdth", label: "Width", min: 75, max: 112.5, default: 100, step: 0.1 },
          ],
        },
        {
          value: "'Azeret Mono Variable', monospace", label: "Azeret Mono",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 900, default: 400, step: 1 },
          ],
        },
        {
          value: "'Recursive Variable', monospace", label: "Recursive",
          axes: [
            { tag: "MONO", label: "Mono", min: 0, max: 1, default: 0, step: 0.01 },
            { tag: "CASL", label: "Casual", min: 0, max: 1, default: 0, step: 0.01 },
            { tag: "wght", label: "Weight", min: 300, max: 1000, default: 400, step: 1 },
            { tag: "slnt", label: "Slant", min: -15, max: 0, default: 0, step: 1 },
            { tag: "CRSV", label: "Cursive", min: 0, max: 1, default: 0.5, step: 0.1 },
          ],
        },
        { value: "'Maple Mono', monospace", label: "Maple Mono" },
        { value: "'Px Grotesk Mono', monospace", label: "Px Grotesk Mono" },
        { value: "'Covik Sans Mono', monospace", label: "Covik Sans Mono" },
        { value: "'ST Monochromic', monospace", label: "ST Monochromic" },
        { value: "'VCTR Mono', monospace", label: "VCTR Mono" },
        { value: "'MD System Mono', monospace", label: "MD System Mono" },
        { value: "'Basically A Mono', monospace", label: "Basically A Mono" },
        { value: "'Necto Mono', monospace", label: "Necto Mono" },
        { value: "'Sligoil', monospace", label: "Sligoil" },
        {
          value: "'Heming', monospace", label: "Heming",
          axes: [
            { tag: "wght", label: "Weight", min: 300, max: 700, default: 300, step: 1 },
          ],
        },
        { value: "'Lab Mono', monospace", label: "Lab Mono" },
        { value: "'Whois Mono', monospace", label: "Whois Mono" },
        {
          value: "'Archivo Variable', sans-serif", label: "Archivo",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 900, default: 400, step: 1 },
            { tag: "wdth", label: "Width", min: 62, max: 125, default: 100, step: 0.1 },
          ],
        },
        {
          value: "'Fredoka Variable', sans-serif", label: "Fredoka",
          axes: [
            { tag: "wght", label: "Weight", min: 300, max: 700, default: 400, step: 1 },
            { tag: "wdth", label: "Width", min: 75, max: 125, default: 100, step: 0.1 },
          ],
        },
        {
          value: "'Unbounded Variable', sans-serif", label: "Unbounded",
          axes: [
            { tag: "wght", label: "Weight", min: 200, max: 900, default: 400, step: 1 },
          ],
        },
        {
          value: "'Funnel Display Variable', sans-serif", label: "Funnel Display",
          axes: [
            { tag: "wght", label: "Weight", min: 300, max: 800, default: 400, step: 1 },
          ],
        },
        {
          value: "'Epilogue Variable', sans-serif", label: "Epilogue",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 900, default: 400, step: 1 },
          ],
        },
        {
          value: "'Atkinson Hyperlegible Next Variable', sans-serif", label: "Atkinson Hyperlegible",
          axes: [
            { tag: "wght", label: "Weight", min: 200, max: 800, default: 400, step: 1 },
          ],
        },
        {
          value: "'Bricolage Grotesque Variable', sans-serif", label: "Bricolage Grotesque",
          axes: [
            { tag: "wght", label: "Weight", min: 200, max: 800, default: 400, step: 1 },
            { tag: "wdth", label: "Width", min: 75, max: 100, default: 100, step: 0.1 },
            { tag: "opsz", label: "Optical Size", min: 12, max: 96, default: 14, step: 0.1 },
          ],
        },
        {
          value: "'Afrikola Formal', sans-serif", label: "Afrikola Formal",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 800, default: 100, step: 1 },
          ],
        },
        {
          value: "'Afrikola Informal', sans-serif", label: "Afrikola Informal",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 800, default: 100, step: 1 },
          ],
        },
        {
          value: "'Rotor', sans-serif", label: "Rotor",
          axes: [
            { tag: "wght", label: "Weight", min: 100, max: 900, default: 400, step: 1 },
            { tag: "RTTX", label: "Rotation", min: 0, max: 360, default: 0, step: 1 },
            { tag: "DPTH", label: "Depth", min: 20, max: 600, default: 200, step: 1 },
          ],
        },
        { value: "'Iosevka Aile', sans-serif", label: "Iosevka Aile" },
        { value: "'MD IO', sans-serif", label: "MD IO" },
        { value: "'MD Nichrome', sans-serif", label: "MD Nichrome" },
        { value: "'MD Primer', sans-serif", label: "MD Primer" },
        { value: "'MD System', sans-serif", label: "MD System" },
        { value: "'MD System Condensed', sans-serif", label: "MD System Condensed" },
        { value: "'MD System Narrow', sans-serif", label: "MD System Narrow" },
        { value: "'MD Lorien', serif", label: "MD Lorien" },
        { value: "'MD Polychrome', sans-serif", label: "MD Polychrome" },
        { value: "'Cotham Sans', sans-serif", label: "Cotham Sans" },
        { value: "'TeX Gyre Heros', sans-serif", label: "TeX Gyre Heros" },
        { value: "'Index', sans-serif", label: "Index" },
      ];

      let currentIndex = 0;
      let axisValues: Record<string, number> = {};

      function buildVariationSettings(): string {
        const entries = Object.entries(axisValues);
        if (entries.length === 0) return "normal";
        return entries.map(([tag, val]) => `'${tag}' ${val}`).join(", ");
      }

      function applyVariationSettings() {
        const settings = buildVariationSettings();
        document.documentElement.style.fontVariationSettings = settings;
        localStorage.setItem("debug-axis-values", JSON.stringify(axisValues));
      }

      function renderAxisControls(font: Font) {
        const container = document.getElementById("axis-controls");
        if (!container) return;
        container.innerHTML = "";
        axisValues = {};

        if (!font.axes || font.axes.length === 0) {
          document.documentElement.style.fontVariationSettings = "normal";
          localStorage.removeItem("debug-axis-values");
          return;
        }

        // Restore saved axis values for this font
        const savedKey = `debug-axis-values:${font.label}`;
        const saved = localStorage.getItem(savedKey);
        const savedValues: Record<string, number> = saved ? JSON.parse(saved) : {};

        for (const axis of font.axes) {
          const val = savedValues[axis.tag] ?? axis.default;
          axisValues[axis.tag] = val;

          const wrapper = document.createElement("div");
          wrapper.className = "mt-2";

          const label = document.createElement("label");
          label.className = "flex justify-between uppercase tracking-wider opacity-50 mb-1";
          const nameSpan = document.createElement("span");
          nameSpan.textContent = `${axis.label}`;
          const tagSpan = document.createElement("span");
          tagSpan.className = "opacity-60 font-normal lowercase";
          tagSpan.textContent = axis.tag;
          const valSpan = document.createElement("span");
          valSpan.textContent = String(val);
          valSpan.id = `axis-val-${axis.tag}`;
          label.append(nameSpan, tagSpan, valSpan);

          const slider = document.createElement("input");
          slider.type = "range";
          slider.min = String(axis.min);
          slider.max = String(axis.max);
          slider.step = String(axis.step);
          slider.value = String(val);
          slider.className = "w-full cursor-pointer accent-cyan-500";

          slider.addEventListener("input", () => {
            const v = parseFloat(slider.value);
            axisValues[axis.tag] = v;
            valSpan.textContent = String(v);
            applyVariationSettings();
            localStorage.setItem(savedKey, JSON.stringify(axisValues));
          });

          wrapper.append(label, slider);
          container.append(wrapper);
        }

        applyVariationSettings();
      }

      function applyFont(i: number) {
        currentIndex = ((i % fonts.length) + fonts.length) % fonts.length;
        const font = fonts[currentIndex];
        document.documentElement.style.setProperty("--font-ibm-plex-mono", font.value);
        localStorage.setItem("debug-font", font.value);
        const nameEl = document.getElementById("font-name");
        const indexEl = document.getElementById("font-index");
        if (nameEl) nameEl.textContent = font.label;
        if (indexEl) indexEl.textContent = `${currentIndex + 1}/${fonts.length}`;
        renderAxisControls(font);
      }

      function initDebugUI() {
        const slider = document.getElementById("font-size") as HTMLInputElement;
        const sizeLabel = document.getElementById("size-label");
        const prevBtn = document.getElementById("font-prev");
        const nextBtn = document.getElementById("font-next");
        if (!slider || !sizeLabel || !prevBtn || !nextBtn) return;

        // Restore saved font
        const savedFont = localStorage.getItem("debug-font");
        if (savedFont) {
          const idx = fonts.findIndex((f) => f.value === savedFont);
          applyFont(idx >= 0 ? idx : 0);
        } else {
          applyFont(0);
        }

        // Restore saved size
        const savedSize = localStorage.getItem("debug-font-size");
        if (savedSize) {
          document.documentElement.style.fontSize = savedSize + "px";
          slider.value = savedSize;
          sizeLabel.textContent = savedSize;
        }

        prevBtn.addEventListener("click", () => applyFont(currentIndex - 1));
        nextBtn.addEventListener("click", () => applyFont(currentIndex + 1));

        slider.addEventListener("input", () => {
          document.documentElement.style.fontSize = slider.value + "px";
          sizeLabel.textContent = slider.value;
          localStorage.setItem("debug-font-size", slider.value);
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
        if (e.key === "ArrowLeft") { e.preventDefault(); applyFont(currentIndex - 1); }
        if (e.key === "ArrowRight") { e.preventDefault(); applyFont(currentIndex + 1); }
      });

      initDebugUI();
      document.addEventListener("astro:after-swap", initDebugUI);
    </script>
  </body>
</html>
