---
const navItems = [
  { href: "/", label: "home" },
  { href: "/lab", label: "lab" },
  { href: "/blog", label: "blog" },
];
---

<header transition:persist class="fixed top-4 md:top-8 w-full z-[100] pointer-events-none">
  <div class="max-w-3xl mx-auto w-full flex justify-start px-5">
    <nav class="relative flex items-center gap-1 p-1 bg-background/30 backdrop-blur-sm md:backdrop-blur-md rounded-full border border-background/40 shadow-lg pointer-events-auto">
    {navItems.map((item) => (
      <a
        href={item.href}
        data-nav-href={item.href}
        class="px-5 py-2 rounded-full uppercase transition-colors duration-300 relative z-10 text-foreground/50 hover:text-foreground"
      >
        {item.label}
      </a>
    ))}
    <div
      id="nav-pill"
      class="absolute top-1 bottom-1 rounded-full bg-foreground shadow-xl transition-all duration-300 ease-out pointer-events-none"
    ></div>
  </nav>
  </div>
</header>

<script>
  function updateNav() {
    const pathname = window.location.pathname;
    const links = document.querySelectorAll<HTMLAnchorElement>("a[data-nav-href]");
    const pill = document.getElementById("nav-pill");
    if (!pill || !links.length) return;

    links.forEach((link) => {
      const href = link.dataset.navHref!;
      const active = href === "/" ? pathname === "/" : pathname.startsWith(href);

      if (active) {
        link.classList.add("text-background", "hover:text-background", "cursor-default");
        link.classList.remove("text-foreground/50", "hover:text-foreground");
        pill.style.left = `${link.offsetLeft}px`;
        pill.style.width = `${link.offsetWidth}px`;
      } else {
        link.classList.remove("text-background", "hover:text-background", "cursor-default");
        link.classList.add("text-foreground/50", "hover:text-foreground");
      }
    });
  }

  // First load: snap pill into place (no transition)
  const pill = document.getElementById("nav-pill");
  if (pill) {
    pill.style.transition = "none";
    updateNav();
    pill.offsetHeight; // force reflow
    pill.style.transition = "";
  }

  // On navigation: pill slides to new position
  document.addEventListener("astro:after-swap", updateNav);
</script>
