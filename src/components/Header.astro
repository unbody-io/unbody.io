---
import { BlobTabs } from "./BlobTabs";
---

<header
  transition:persist
  class:list={[
    "fixed",
    "top-4",
    "md:top-8",
    "w-full",
    "z-[100]",
    "pointer-events-none",
  ]}
>
  <div
    class:list={[
      "w-full",
      "max-w-3xl",
      "mx-auto",
      "px-5",
      "md:px-8",
    ]}
  >
    <div class="pointer-events-auto w-[38px] -translate-x-[48px]">
      <BlobTabs client:load />
    </div>
  </div>
</header>
