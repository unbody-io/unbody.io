---
import type { PostMetadata } from "@/types/data.types";

interface Props {
  post: PostMetadata;
}

const { post } = Astro.props;

const formattedDate = new Date(post.publishDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="group">
  <a href={`/blog/${post.slug}`} class="block">
    <div class="mb-3 flex items-center gap-3 text-sm text-muted-foreground">
      <time datetime={post.publishDate}>{formattedDate}</time>
      <span class="opacity-30">|</span>
      <span>{post.readingTime} min read</span>
      <span class="opacity-30">|</span>
      <span class="uppercase tracking-wider text-xs">{post.category}</span>
    </div>

    <h2 class="mb-3 text-foreground text-lg group-hover:text-accent transition-colors duration-300">
      {post.title}
    </h2>

    <p class="leading-relaxed text-muted-foreground">{post.blurb}</p>
  </a>
</article>
